<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Focus lifts cards above neighbours without casting a downward shadow. -->
    <style name="Tarn" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/tarn_black</item>
        <item name="android:colorAccent">@color/tarn_lake_blue</item>
        <item name="android:spotShadowAlpha">0</item>
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:windowAnimationStyle">@style/Tarn.Screens</item>
    </style>

    <!-- Static launch window on Android 6–11; no timer or startup work. -->
    <style name="Tarn.Start">
        <item name="android:windowBackground">@drawable/tarn_start_window</item>
    </style>

    <!-- A screen drawn over another without stopping it (the source list over the player). Its own art covers it. -->
    <style name="Tarn.Over">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- The player: the screen behind dims to black before the video fades up. -->
    <style name="Tarn.Player">
        <item name="android:windowAnimationStyle">@style/Tarn.Screens.Player</item>
    </style>

    <!-- Screen changes (design/DESIGN_SYSTEM.md "Motion"; durations match Screen.kt's PAGE_MS, QUICK_MS, IDLE_MS).
         Window animations follow Android's transition scale, so Remove animations turns them off. -->
    <style name="Tarn.Screens" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <style name="Tarn.Screens.Player">
        <item name="android:activityOpenEnterAnimation">@anim/player_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/lights_down</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_open_exit</item>
    </style>
</resources>

import type {PlaybackIntent} from './liveCatalogue.ts';
export type Source={url:string;provider:string;name:string;description:string;height:number;hevc:boolean;av1:boolean;hdr:boolean;riskyAudio:boolean;subtitles:Subtitle[]};
export type Subtitle={url:string;lang:string;label:string;provider:string};
export type DeviceCapabilities={height:number;hevc:boolean;av1:boolean;hdr:boolean};
export type Excluded={torrent:number;headers:number;external:number;other:number};
export type Resolution={sources:Source[];excluded:Excluded;failures:number;providers:number};
export type ResourceAddon={base:string;name:string};
export type Requester=(url:string,init?:RequestInit,signal?:AbortSignal)=>Promise<unknown>;
export type Progress={position:number;duration:number;updatedAt:number};
export function httpUrl(value:unknown):string|null;
export function resourceAddons(descriptors:unknown[],resource:string,intent:PlaybackIntent):ResourceAddon[];
export function resourceUrl(addon:ResourceAddon,resource:string,intent:PlaybackIntent):string;
export function parseSubtitles(raw:unknown,provider:string):Subtitle[];
export function parseStreams(raw:unknown,provider:string):{sources:Source[];excluded:Excluded};
export function rankSources(sources:Source[],capabilities:DeviceCapabilities):Source[];
export function resolveStreams(descriptors:unknown[],intent:PlaybackIntent,signal:AbortSignal,request:Requester):Promise<Resolution>;
export function resolveSubtitles(descriptors:unknown[],intent:PlaybackIntent,signal:AbortSignal,request:Requester):Promise<Subtitle[]>;
export function uniqueSubtitles(tracks:Subtitle[]):Subtitle[];
export function toVtt(text:string):string;
export function resumePosition(record:Progress|null):number;
export function seekPosition(position:number,duration:number,delta:number):number;
export function progressKey(account:string,intent:PlaybackIntent):string;

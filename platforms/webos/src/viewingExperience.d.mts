import type {Episode} from './liveCatalogue.ts';
export type ViewingSession={profile:string;autoStarts:number;suppressed:boolean;pendingFrame:boolean};
export type Thumbnail={start:number;end:number;url:string;crop:{x:number;y:number;w:number;h:number}|null};
export const STILL_THRESHOLD:number;
export function newSession(profile:string):ViewingSession;
export function forAdvance(session:ViewingSession,origin:'manual'|'autoplay'):ViewingSession;
export function firstFrame(session:ViewingSession):ViewingSession;
export function intentionalInput(session:ViewingSession):ViewingSession;
export function confirmWatching(session:ViewingSession,suppress:boolean):ViewingSession;
export function shouldAsk(session:ViewingSession):boolean;
export function episodeAired(e:Episode,now?:number):boolean;
export function seasonStats(episodes:Episode[],watched:(id:string)=>boolean,now?:number):{season:number|null;total:number;unwatched:number}[];
export function episodeTarget(episodes:Episode[],watched:(id:string)=>boolean,resume:(id:string)=>number,now?:number,preferredId?:string):Episode|null;
export function thumbnailCue(text:unknown,start:number,end:number,base:string,resolve:(url:string,base:string)=>string):Thumbnail|null;
